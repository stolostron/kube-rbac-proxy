FROM registry.redhat.io/openshift/golang-builder:golang-builder-v1.26-rhel9 AS builder

WORKDIR /workspace

# Source is imported via the openshift-kube-rbac-proxy submodule, which tracks
# https://github.com/openshift/kube-rbac-proxy. To move to a new version, bump
# the submodule reference rather than editing anything here.
COPY openshift-kube-rbac-proxy/ .

# The upstream repository commits its vendor/ directory, so -mod=vendor keeps the
# build fully offline and hermetic-safe. CGO_ENABLED=1 is required for the
# FIPS-validated crypto backend provided by the ART golang builder.
# The -X flags are the subset of upstream's Makefile ldflags that survive losing
# the .git directory; gitCommit is omitted because COPY does not carry it.
RUN CGO_ENABLED=1 GOEXPERIMENT=strictfipsruntime GOFLAGS="" go build \
    -mod=vendor \
    --installsuffix cgo \
    -ldflags "-X k8s.io/component-base/version.gitVersion=$(cat VERSION) -X k8s.io/component-base/version/verflag.programName=kube-rbac-proxy" \
    -o kube-rbac-proxy \
    ./cmd/kube-rbac-proxy

FROM registry.redhat.io/ubi9/ubi-minimal-pqc:latest

ARG IMAGE_NAME="kube-rbac-proxy"
ARG CPE_LABEL="cpe:/a:redhat:acm:5.1::el9"

COPY --from=builder /workspace/kube-rbac-proxy /usr/local/bin/kube-rbac-proxy
COPY --from=builder /workspace/LICENSE /licenses/.

EXPOSE 8080
USER 65532:65532

ENTRYPOINT ["/usr/local/bin/kube-rbac-proxy"]

LABEL com.redhat.component="kube-rbac-proxy" \
name="${IMAGE_NAME}" \
cpe="${CPE_LABEL}" \
summary="kube-rbac-proxy" \
io.openshift.expose-services="" \
io.openshift.tags="data,images" \
io.k8s.display-name="kube-rbac-proxy" \
maintainer="" \
description="kube-rbac-proxy" \
io.k8s.description="kube-rbac-proxy"
